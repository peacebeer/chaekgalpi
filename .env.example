# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
# 배포용 값은 Vercel 대시보드 → Project → Settings → Environment Variables 에 따로 넣습니다.

# --- 브라우저에 공개돼도 되는 값 (NEXT_PUBLIC_ 접두어) --------------------------
# Supabase 대시보드 → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (예전 이름: anon public key). RLS가 데이터를 지켜 주므로 공개돼도 괜찮다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 서버에서만 쓰는 비밀 값 (절대 NEXT_PUBLIC_ 을 붙이지 말 것) -----------------
# 국립중앙도서관 Open API 인증키 (ISBN 서지정보 API)
NLK_API_KEY=

# Supabase Secret key (예전 이름: service_role key). RLS를 무시하므로 MVP에서는 쓰지 않는 것이 원칙.
# 꼭 필요해지면 서버 코드에서만 사용하고, 이유를 PR에 적는다.
# SUPABASE_SECRET_KEY=
