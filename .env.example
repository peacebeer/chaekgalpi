# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
# 배포용 값은 Vercel 대시보드 → Project → Settings → Environment Variables 에 따로 넣습니다.

# --- 브라우저에 공개돼도 되는 값 (NEXT_PUBLIC_ 접두어) --------------------------
# Supabase 대시보드 → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (예전 이름: anon public key). RLS가 데이터를 지켜 주므로 공개돼도 괜찮다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- 서버에서만 쓰는 비밀 값 (절대 NEXT_PUBLIC_ 을 붙이지 말 것) -----------------
# 국립중앙도서관 Open API 인증키 (ISBN 서지정보 API)
NLK_API_KEY=

# 카카오 책 검색 REST API 키 (https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키)
# 비워 두면 국립중앙도서관 검색만 쓴다(표지 없음, 제목·ISBN 검색만).
KAKAO_REST_API_KEY=

# Supabase Secret key (예전 이름: service_role key). RLS를 무시하므로 MVP에서는 쓰지 않는 것이 원칙.
# 꼭 필요해지면 서버 코드에서만 사용하고, 이유를 PR에 적는다.
# SUPABASE_SECRET_KEY=

# --- E2E 테스트 계정 (선택) -------------------------------------------------------
# 두 회원이 얽힌 흐름(e2e/progress-lock.spec.ts)을 내 컴퓨터에서 돌릴 때만 필요하다.
# Supabase 대시보드에서 테스트 전용 계정 두 개를 만들어 적는다. 비워 두면 그 테스트는 건너뛴다.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# 체험하기(익명 로그인) E2E(e2e/demo.spec.ts)를 내 컴퓨터에서 돌릴 때 1로 둔다.
# Supabase 대시보드에서 익명 로그인(Allow anonymous sign-ins)을 켠 뒤에만 쓴다.
E2E_DEMO=
